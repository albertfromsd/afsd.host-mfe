# ---------------------------------------------------------------------------
# Module Federation URLs
# ---------------------------------------------------------------------------
# Origin where each MFE serves its federation entry. In production these
# should be the public CDN/origin of the deployed app.
# Note: PUBLIC_*-prefixed vars are inlined at build time (loadEnv prefixes).

PUBLIC_HOST_TEMPLATE_URL=http://localhost:3000
PUBLIC_REMOTE_TEMPLATE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Bundle analyzer (set to "true" when running `pnpm analyze`)
# ---------------------------------------------------------------------------
# ANALYZE=true
